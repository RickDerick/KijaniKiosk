# {{ ansible_managed }}
server {
    listen {{ kk_http_port }} default_server;
    listen [::]:{{ kk_http_port }} default_server;
    server_name _;

    location / {
        proxy_pass http://127.0.0.1:{{ kk_services[kk_role_service].port }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
